#!/bin/bash -l
#SBATCH --account=harmslab
#SBATCH --partition=gpulong
#SBATCH --time=02-00:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=0
#SBATCH --ntasks-per-node=1

# One step of tfs-fit-two-stage (planning/studies/two-stage-validation),
# called as a module, so it needs no reinstall for the new console script,
# submitted by submit.sh, which sets the job name, log file, dependencies
# and (for the jackknife) the array.
#
#   CFG   the two-stage YAML
#   OUT   the output directory
#   STEP  stage1 | jackknife | stage2 | kshift_predict | consistency | summary
#         (jackknife runs task SLURM_ARRAY_TASK_ID)

module load cuda/12.4.1
set -e
CFG="${CFG:?set CFG}"
OUT="${OUT:?set OUT}"
STEP="${STEP:?set STEP}"
echo ">>> ${STEP} ${SLURM_ARRAY_TASK_ID:-} $(date)"
case "${STEP}" in
    jackknife)
        python -m tfscreen.tfmodel.scripts.fit_two_stage_cli "${CFG}" --out_dir "${OUT}" \
            --jackknife_task "${SLURM_ARRAY_TASK_ID:?run as an array}" ;;
    kshift_predict)
        python -m tfscreen.tfmodel.scripts.fit_two_stage_cli "${CFG}" --out_dir "${OUT}" --step kshift
        python -m tfscreen.tfmodel.scripts.fit_two_stage_cli "${CFG}" --out_dir "${OUT}" --step predict ;;
    *)
        python -m tfscreen.tfmodel.scripts.fit_two_stage_cli "${CFG}" --out_dir "${OUT}" --step "${STEP}" ;;
esac
echo ">>> Done ${STEP} ${SLURM_ARRAY_TASK_ID:-} $(date)"

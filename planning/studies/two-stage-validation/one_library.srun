#!/bin/bash -l
#SBATCH --account=harmslab
#SBATCH --partition=gpulong
#SBATCH --time=02-00:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=0
#SBATCH --ntasks-per-node=1
#SBATCH --job-name=ts_one_library

# Stage 2 on one library alone (one_library.py). Run from the validation
# directory:
#   sbatch --export=ALL,RUN=real,LIB=pheS .../one_library.srun

module load cuda/12.4.1
set -e
RUN="${RUN:?set RUN (seed1, seed2 or real)}"
LIB="${LIB:?set LIB (kanR or pheS)}"
HERE=/gpfs/home/harms/tfscreen/planning/studies/two-stage-validation
echo ">>> one library ${RUN} ${LIB} $(date)"
python "${HERE}/one_library.py" "${HERE}/two_stage_${RUN}.yaml" "run_${RUN}" "${LIB}"
echo ">>> Done one library ${RUN} ${LIB} $(date)"

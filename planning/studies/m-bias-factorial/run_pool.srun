#!/bin/bash -l
#SBATCH --account=harmslab
#SBATCH --job-name=tfs_pool
#SBATCH --output=run_pool.out
#SBATCH --error=run_pool.err
#SBATCH --partition=gpulong
#SBATCH --time=00-04:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=0
#SBATCH --ntasks-per-node=1

# Step 2 of planning/deep-coverage.md, part 3: pool the draws' X posteriors
# into one equal-weight mixture (tfs-compare-runs' aggregate), run from
# km_draws/ once every draw_*/run.out ends with ">>> Done". Writes
# pooled_aggregate.csv (the pooled quantiles) and pooled.csv (the draws'
# disagreement per genotype).

set -e
ls draw_*/tfs_pred_theta.csv > pooled_inputs.txt
echo ">>> Pool $(wc -l < pooled_inputs.txt) draws $(date)"
tfs-compare-runs pooled_inputs.txt --out_prefix pooled
echo ">>> Done $(date)"

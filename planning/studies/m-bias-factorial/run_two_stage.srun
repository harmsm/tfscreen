#!/bin/bash -l
#SBATCH --account=harmslab
#SBATCH --job-name=tfs_2stage
#SBATCH --output=run_two_stage.out
#SBATCH --error=run_two_stage.err
#SBATCH --partition=gpulong
#SBATCH --time=02-00:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=0
#SBATCH --ntasks-per-node=1

# The two-stage fit of one full-size simulation (planning/studies/
# m-bias-factorial, README "Second seed"), run from a directory made by
# full-size-sim/make_sim_config.py:
#
#   1. simulate and process (skipped when tfs_growth.csv exists),
#   2. stage 1: wt, spikes and singles only (make_subsets.py no_doubles,
#      run_arm.sh: configure, staged MAP, extract), plus its arrowhead
#      Laplace for step 2's k/m draws,
#   3. stage 2: the full library with every condition's k and m pinned at
#      stage 1's MAP (held_priors.py, run_held.srun's chain).
#
# Every step is skipped when its output exists, so a resubmit resumes.
#
#   SEED  the simulation and fit seed (default 1; match make_sim_config's)
#   TFS   the tfscreen checkout (default /gpfs/home/harms/tfscreen)
#   STAGES  2 (default) runs both stages; 1 stops after stage 1 and its
#           Laplace (enough to read stage 1's k and m)

module load cuda/12.4.1

set -e
SEED="${SEED:-1}"
TFS="${TFS:-/gpfs/home/harms/tfscreen}"
STAGES="${STAGES:-2}"
STUDY="${TFS}/planning/studies/m-bias-factorial"

if [[ -f tfs_growth.csv ]]; then
    echo ">>> Simulate and process: tfs_growth.csv exists, skipped"
else
    if [[ ! -f tfs_sim_tubes.csv ]]; then
        echo ">>> Simulate $(date)"
        tfs-simulate simulate_config.yaml --out_prefix tfs_sim --seed "${SEED}"
    fi
    echo ">>> Process counts $(date)"
    tfs-process-counts tfs_sim_tubes.csv tfs_sim_counts \
        --od600_file tfs_sim_tube_od600.csv \
        --od600_calibration_file tfs_sim_od600_calibration.yaml \
        --tube_volume_mL 5 \
        --out_prefix tfs_growth --no_verbose
fi

S1=stage1/no_doubles
if [[ ! -f ${S1}/tfs_growth.csv ]]; then
    echo ">>> Stage 1 subset $(date)"
    python "${STUDY}/make_subsets.py" . --out_dir stage1 --arms no_doubles
fi
if [[ ! -f ${S1}/tfs_params_growth_m.csv ]]; then
    echo ">>> Stage 1 fit $(date)"
    (cd "${S1}" && bash "${STUDY}/run_arm.sh")
fi
if [[ ! -f ${S1}/tfs_posterior.h5 ]]; then
    echo ">>> Stage 1 Laplace $(date)"
    (cd "${S1}" && tfs-sample-posterior tfs_configure_config.yaml \
        tfs_fit_model_checkpoint.pkl --laplace arrowhead \
        --num_posterior_samples 1000 --skip_growth_observations \
        > laplace.log 2>&1)
fi

if [[ "${STAGES}" == "1" ]]; then
    echo ">>> Stage 2: skipped (STAGES=1)"
elif [[ -f stage2/summary/tfs_summarize_fit_summary.json ]]; then
    echo ">>> Stage 2: done, skipped"
else
    echo ">>> Stage 2 setup $(date)"
    mkdir -p stage2
    (cd stage2 \
        && python "${STUDY}/held_priors.py" "../${S1}" --out growth_priors_held.csv \
        && ln -sf ../tfs_growth.csv . \
        && for f in ../tfs_sim_*; do ln -sf "${f}" .; done \
        && cp ../library_config.yaml .)
    echo ">>> Stage 2 fit (every condition pinned) $(date)"
    (cd stage2 && SEED="${SEED}" bash "${STUDY}/run_held.srun" > run.out 2> run.err)
fi

echo ">>> Done $(date)"
